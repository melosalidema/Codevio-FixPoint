# Fixpoint environment. Never commit real values (fixpoint-plan.html:870).

FIXPOINT_ENV=mock
FIXPOINT_DB_URL=postgresql://fixpoint:fixpoint@localhost:5432/fixpoint

# Sealed-context / approval-token signing key. Rotate in production.
FIXPOINT_SIGNING_KEY=dev-only-change-me

# Deterministic safety envelope (plan numbers, fixpoint-plan.html:565-568, :657)
FIXPOINT_MAX_REFUND_CENTS=250000
FIXPOINT_APPROVAL_THRESHOLD_CENTS=10000
FIXPOINT_AUTO_APPROVE_CENTS=2500
FIXPOINT_TEAM_LEAD_CENTS=25000
FIXPOINT_DUAL_APPROVAL_CENTS=250000

# Agent model (optional in mock mode; leave blank to use the scripted planner)
FIXPOINT_LLM_BASE_URL=
FIXPOINT_LLM_API_KEY=
FIXPOINT_LLM_MODEL=

# Arga twins are NOT guaranteed -> local twins/ are the default backend.
FIXPOINT_USE_ARGA=false
FIXPOINT_ARGA_BASE_URL=
