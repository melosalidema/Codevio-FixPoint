# ---------------------------------------------------------------------------
# Fixpoint environment. Copy to .env for local development.
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

FIXPOINT_ENV=development

# Database. Railway injects DATABASE_URL when you attach the Postgres plugin.
# Local default (if unset) is sqlite+aiosqlite:///./fixpoint.db
# FIXPOINT_DATABASE_URL=postgresql://fixpoint:fixpoint@localhost:5432/fixpoint

# HMAC keys. REQUIRED in production; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FIXPOINT_SIGNING_KEY=dev-only-change-me
FIXPOINT_WEBHOOK_SECRET=dev-webhook-secret

# Enables the audit-tamper demo endpoint and UI button.
FIXPOINT_DEMO_MODE=true

# Sealed safety envelope (values in cents).
FIXPOINT_MAX_REFUND_CENTS=250000        # $2,500 hard cap
FIXPOINT_APPROVAL_THRESHOLD_CENTS=10000 # $100
FIXPOINT_AUTO_APPROVE_CENTS=2500        # $25 autonomous
FIXPOINT_TEAM_LEAD_CENTS=25000          # $250 -> team lead
FIXPOINT_DUAL_APPROVAL_CENTS=250000     # $2,500 -> dual approval + SoD
FIXPOINT_MAX_ACTIONS_PER_RUN=20

# Stand-ins for the authenticated session (auth is on the production roadmap).
FIXPOINT_DEFAULT_TENANT_ID=t_123
FIXPOINT_DEFAULT_ACTOR_USER_ID=u_88

# Optional LLM planner. When disabled (default) the deterministic parser and
# planner run: fully offline and replayable. When enabled the model only
# proposes; the Action Gateway still authorizes and any LLM failure falls back
# to the deterministic planner.
#
# Default is Pollinations: free, keyless, OpenAI-compatible. Any OpenAI-compatible
# endpoint works (Groq https://api.groq.com/openai/v1, GitHub Models
# https://models.github.ai/inference, OpenAI https://api.openai.com/v1, local
# http://localhost:1234/v1). Set the API key if the provider needs one.
FIXPOINT_LLM_ENABLED=false
# Provider preset: pollinations (free, keyless), groq, gemini, github, openai, custom.
# groq/gemini/github/openai need only an API key; custom needs base URL + model.
FIXPOINT_LLM_PROVIDER=pollinations
FIXPOINT_LLM_API_KEY=
# Optional overrides (custom requires both base URL and model).
FIXPOINT_LLM_BASE_URL=
FIXPOINT_LLM_MODEL=
FIXPOINT_LLM_TIMEOUT_SECONDS=45
# Also use the model for fact extraction (default: deterministic parser only,
# which is safer and makes one model call per run instead of two).
FIXPOINT_LLM_PARSE_ENABLED=false

# Provider backend: "twin" (in-process deterministic twins, default) or "arga"
# (Arga digital twins over HTTP). Arga twins are API-compatible replicas of
# Stripe, Gmail, Slack, HubSpot and Google Drive.
FIXPOINT_PROVIDER_BACKEND=twin
FIXPOINT_ARGA_BASE_URL=

# CORS for the Vite dev server only. Production serves the SPA same-origin.
FIXPOINT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set automatically inside the Docker image.
# FIXPOINT_STATIC_DIR=/app/static
