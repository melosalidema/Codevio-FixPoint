# ---------------------------------------------------------------------------
# Fixpoint environment. Copy to .env for local development.
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

FIXPOINT_ENV=development

# Database. Railway injects DATABASE_URL when you attach the Postgres plugin.
# Local default (if unset) is sqlite+aiosqlite:///./fixpoint.db
# FIXPOINT_DATABASE_URL=postgresql://fixpoint:fixpoint@localhost:5432/fixpoint

# HMAC keys. REQUIRED in production; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FIXPOINT_SIGNING_KEY=dev-only-change-me
FIXPOINT_WEBHOOK_SECRET=dev-webhook-secret

# Enables the audit-tamper demo endpoint and UI button.
FIXPOINT_DEMO_MODE=true

# Sealed safety envelope (values in cents).
FIXPOINT_MAX_REFUND_CENTS=250000        # $2,500 hard cap
FIXPOINT_APPROVAL_THRESHOLD_CENTS=10000 # $100
FIXPOINT_AUTO_APPROVE_CENTS=2500        # $25 autonomous
FIXPOINT_TEAM_LEAD_CENTS=25000          # $250 -> team lead
FIXPOINT_DUAL_APPROVAL_CENTS=250000     # $2,500 -> dual approval + SoD
FIXPOINT_MAX_ACTIONS_PER_RUN=20

# Stand-ins for the authenticated session (auth is on the production roadmap).
FIXPOINT_DEFAULT_TENANT_ID=t_123
FIXPOINT_DEFAULT_ACTOR_USER_ID=u_88

# CORS for the Vite dev server only. Production serves the SPA same-origin.
FIXPOINT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set automatically inside the Docker image.
# FIXPOINT_STATIC_DIR=/app/static
